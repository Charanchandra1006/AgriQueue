# ==============================================================================
# AgriQueue — Root Environment Variables
# ==============================================================================
# Copy this file to .env in both frontend/ and backend/ directories
# and fill in your values. NEVER commit the actual .env files.

# ── Frontend (frontend/.env) ──────────────────────────────────────────────────
VITE_API_URL=https://agriqueue-hk9u.onrender.com/api
VITE_ADMIN_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── Backend (backend/.env) ────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=https://agri-queue-gamma.vercel.app

# TiDB Serverless / MySQL 8+ Database
DB_HOST=your_tidb_host_here
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=agriqueue
DB_SSL=true

# Government of India — data.gov.in / AGMARKNET API
# Register at https://data.gov.in to get your key
DATA_GOV_API_KEY=your_data_gov_api_key

# Google Gemini AI — Voice Agent
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
